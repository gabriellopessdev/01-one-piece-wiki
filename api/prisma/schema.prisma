generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Character {
  id          String  @id @default(cuid())
  externalId  Int     @unique
  name        String
  crew        String?
  fruit       String?
  imageUrl    String?
  description String?
}
